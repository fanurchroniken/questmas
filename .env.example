# Frontend Environment Variables
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Writer's Tool
VITE_ENVIRONMENT=development

# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/writers_tool_dev
# OR for MongoDB
# MONGODB_URI=mongodb://localhost:27017/writers_tool_dev

# Object Database (if separate)
# OBJECT_DB_URL=mongodb://localhost:27017/writers_tool_objects

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# OR for cloud storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# Third-party Services
# SPELL_CHECK_API_KEY=
# EMAIL_SERVICE_API_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
